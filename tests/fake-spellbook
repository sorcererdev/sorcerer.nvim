#!/usr/bin/env python3
# A stand-in for `spellbook check --json` in tests: prints $FAKE_SPELLBOOK_JSON's file (or, with
# $FAKE_SPELLBOOK_STDERR, that text on stderr) and exits with $FAKE_SPELLBOOK_EXIT (default 0).
import os
import sys

if os.environ.get("FAKE_SPELLBOOK_STDERR"):
    sys.stderr.write(os.environ["FAKE_SPELLBOOK_STDERR"])
path = os.environ.get("FAKE_SPELLBOOK_JSON")
if path:
    sys.stdout.write(open(path).read())
sys.exit(int(os.environ.get("FAKE_SPELLBOOK_EXIT", "0")))
