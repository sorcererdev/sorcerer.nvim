#!/usr/bin/env python3
# A stand-in for `scry lsp` (or, with $FAKE_LSP_NAME, another server) in tests, started as `fake-lsp lsp` (the argument is ignored).
# It announces what scry announces (open/close/save sync without text, code actions, the
# three scry.* commands) and records every message it gets to $FAKE_LSP_LOG (one JSON per
# line). On textDocument/didSave it does what the real server does: a
# window/workDoneProgress/create request (token sorcerer-1) it waits to be answered, then
# $/progress begin (title scry, "reviewing 2 units"), an optional report (the text in
# $FAKE_LSP_REPLIES/report.json as {"report": "..."}), publishDiagnostics for the file with
# the findings in $FAKE_LSP_REPLIES/diagnostics.json, then $/progress end (no message).
# diagnostics.json is a list of {"line": <0-based>, "code": "bug", "statement": "...",
# "rule": "r1" (optional), "stale": true (optional), "id": "f1", "evidence": "..." (optional)};
# they are published shaped as scry's: the whole line, severity 1 for bug else 2, source scry,
# code the issue type (type-stale when stale), data the finding id, relatedInformation only
# when the client's initialize advertised it. A workspace/executeCommand of spellbook.apply, when
# $FAKE_LSP_REPLIES/workspace_applyEdit.json exists, first sends the server request
# workspace/applyEdit with that file's params, waits for the editor's answer (logged like any
# message) and only then answers the command, as the real spellbook does. When the client's initializationOptions say
# drawsWorking, a save also sends sorcerer/working with the file's first line before the
# progress begins, and an empty list 1.5 s after it, before the progress ends.
import json
import os
import sys
import time
from urllib.parse import unquote, urlparse

log = open(os.environ.get("FAKE_LSP_LOG", "/dev/null"), "a")
related_ok = False
draws_working = False


def read():
    length = None
    while True:
        line = sys.stdin.buffer.readline()
        if not line:
            sys.exit(0)
        line = line.decode().strip()
        if not line:
            break
        if line.lower().startswith("content-length:"):
            length = int(line.split(":")[1])
    msg = json.loads(sys.stdin.buffer.read(length))
    log.write(json.dumps(msg) + "\n")
    log.flush()
    return msg


def send(msg):
    body = json.dumps(msg).encode()
    sys.stdout.buffer.write(b"Content-Length: %d\r\n\r\n" % len(body) + body)
    sys.stdout.buffer.flush()


def canned(name):
    path = os.path.join(os.environ.get("FAKE_LSP_REPLIES", "/nonexistent"), name)
    return json.load(open(path)) if os.path.exists(path) else None


def reply_for(method, params):
    # an executeCommand is answered from workspace_executeCommand_<command>.json, first from
    # ..._<command>_<last argument>.json when the last argument is text (spellbook.choices
    # asks for each input by name)
    if method == "workspace/executeCommand":
        base = "workspace_executeCommand_" + params["command"]
        last = (params.get("arguments") or [None])[-1]
        if isinstance(last, str):
            named = canned(base + "_" + last + ".json")
            if named is not None:
                return named
        return canned(base + ".json")
    return canned(method.replace("/", "_") + ".json")


def utf16_len(s):
    return len(s.encode("utf-16-le")) // 2


def diagnostics_for(uri):
    path = unquote(urlparse(uri).path)
    try:
        lines = open(path, encoding="utf-8").read().split("\n")
    except OSError:
        lines = []
    out = []
    for spec in canned("diagnostics.json") or []:
        line = spec["line"]
        text = lines[line] if line < len(lines) else ""
        message = [spec["statement"]]
        if spec.get("rule"):
            message.append("rule: " + spec["rule"])
        if spec.get("stale"):
            message.append("(the code changed since this review)")
        d = {
            "range": {"start": {"line": line, "character": 0}, "end": {"line": line, "character": utf16_len(text)}},
            "severity": 1 if spec["code"] == "bug" else 2,
            "source": "scry",
            "code": spec["code"] + ("-stale" if spec.get("stale") else ""),
            "message": "\n".join(message),
            "data": spec["id"],
        }
        if related_ok and spec.get("evidence"):
            d["relatedInformation"] = [{"location": {"uri": uri, "range": d["range"]}, "message": spec["evidence"]}]
        out.append(d)
    return out


def progress(value):
    send({"jsonrpc": "2.0", "method": "$/progress", "params": {"token": "sorcerer-1", "value": value}})


def working(units):
    send({"jsonrpc": "2.0", "method": "sorcerer/working", "params": {"units": units}})


def on_save(uri):
    send({"jsonrpc": "2.0", "id": "srv-1", "method": "window/workDoneProgress/create", "params": {"token": "sorcerer-1"}})
    while True:  # hold the begin until the editor answers
        reply = read()
        if reply.get("id") == "srv-1" and "method" not in reply:
            break
    if draws_working:
        working([{"uri": uri, "line": 0, "text": "\u27f3 scry: reviewing\u2026"}])
    progress({"kind": "begin", "title": "scry", "message": "reviewing 2 units"})
    report = canned("report.json")
    if report:
        progress({"kind": "report", "message": report["report"]})
    send({"jsonrpc": "2.0", "method": "textDocument/publishDiagnostics", "params": {"uri": uri, "diagnostics": diagnostics_for(uri)}})
    if draws_working:
        time.sleep(1.5)
        working([])
    progress({"kind": "end"})


while True:
    msg = read()
    method = msg.get("method")
    if method is None:
        continue  # the client's answer to a server request
    if method == "initialize":
        caps = (msg["params"].get("capabilities") or {}).get("textDocument", {}).get("publishDiagnostics", {})
        related_ok = bool(caps.get("relatedInformation"))
        draws_working = bool((msg["params"].get("initializationOptions") or {}).get("drawsWorking"))
        send({"jsonrpc": "2.0", "id": msg["id"], "result": {"capabilities": {
            "textDocumentSync": {"openClose": True, "save": {"includeText": False}, "change": 0},
            "codeActionProvider": True,
            "executeCommandProvider": {"commands": ["scry.why", "scry.showCode", "scry.dismiss", "conjure.conjure", "conjure.undo", "conjure.why"]},
        }, "serverInfo": {"name": os.environ.get("FAKE_LSP_NAME", "scry")}}})
    elif method == "shutdown":
        send({"jsonrpc": "2.0", "id": msg["id"], "result": None})
    elif method == "exit":
        sys.exit(0)
    elif method == "textDocument/didSave":
        on_save(msg["params"]["textDocument"]["uri"])
    elif "id" in msg:
        if method == "workspace/executeCommand" and msg["params"]["command"] == "spellbook.apply" and canned("workspace_applyEdit.json"):
            send({"jsonrpc": "2.0", "id": "srv-edit", "method": "workspace/applyEdit", "params": canned("workspace_applyEdit.json")})
            while True:  # the apply waits for the editor's answer
                answer = read()
                if answer.get("id") == "srv-edit" and "method" not in answer:
                    break
        send({"jsonrpc": "2.0", "id": msg["id"], "result": reply_for(method, msg["params"])})
